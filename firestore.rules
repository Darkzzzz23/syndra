rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'workspaceName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedInAs(uid);

      allow update: if signedInAs(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'workspaceName', 'updatedAt'
        ]);

      allow delete: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
